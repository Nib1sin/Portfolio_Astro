---
import Header from "../components/Header.astro";
import Footer from "@/components/Footer.astro";
import "@fontsource-variable/onest";
import "@/styles/global.css";

import { LOCALES, DEFAULT_LOCALE, getLocaleFromPathname, t } from "@/i18n/i18n";
import imageMe from "@/assets/image_me.webp";

const locale = getLocaleFromPathname(Astro.url.pathname);

const title = t(locale, "seo.title");
const description = t(locale, "seo.description");

// ponytail: sitio de una sola pagina, la ruta base siempre es "/"
const localeHref = (l: string) =>
  new URL(l === DEFAULT_LOCALE ? "/" : `/${l}/`, Astro.site).href;

const canonical = localeHref(locale);
const ogImage = new URL(imageMe.src, Astro.site).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Pedro",
  jobTitle: "Full Stack Software Engineer",
  url: canonical,
  image: ogImage,
  description,
  knowsAbout: ["Java", "Spring Boot", "Groovy", "Angular", "TypeScript", "SQL", "NoSQL"],
  sameAs: [
    "https://www.linkedin.com/in/pjaimer/",
    "https://github.com/Nib1sin",
  ],
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <link rel="canonical" href={canonical} />
    {LOCALES.map((l) => (
      <link rel="alternate" hreflang={l} href={localeHref(l)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={localeHref(DEFAULT_LOCALE)} />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="Portfolio Pedro" />
    <meta property="og:locale" content={locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    <script is:inline>
      // ponytail: sync pre-hydration read to avoid a light->dark flash on full page loads
      const storedTheme = localStorage.getItem("theme");
      const isDark =
        storedTheme === "dark" ||
        (storedTheme !== "light" &&
          window.matchMedia("(prefers-color-scheme: dark)").matches);
      document.documentElement.classList.toggle("dark", isDark);
    </script>
  </head>
  <body class="relative text-black dark:text-white">
    <div
      class="absolute top-0 bottom-0 z-[-2] min-h-screen w-full
    bg-gray-50
    bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(217,216,255,0.9),rgba(255,255,255,0.5))]
    dark:bg-gray-950
    dark:bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(120,119,198,0.4),rgba(255,255,255,0))]"
    >
    </div>
    <Header />
    <slot />
    <Footer />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --scrollbar-color-light: #666666;
    --scrollbar-color-dark: #cccccc;
  }

  html {
    font-family: "Onest Variable", system-ui, sans-serif;
    scroll-behavior: smooth;
  }

  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    overscroll-behavior: none;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }

  .p-hidden {
    display: block;
    white-space: nowrap;
    border-right: 4px solid;
    width: 15.5ch;
    max-width: 100%;

    animation:
      typing 2s steps(12),
      blink 0.5s infinite step-end alternate;
    overflow: hidden;
  }

  @keyframes typing {
    from {
      width: 0;
    }
  }

  @keyframes blink {
    50% {
      border-color: transparent;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .p-hidden {
      animation: none;
      border-right-color: transparent;
    }
  }
</style>
