---
import ExperienceItem from "@/components/experience/ExperienceItem.astro";
import { getLocaleFromPathname, t } from "@/i18n/i18n";

const locale = getLocaleFromPathname(Astro.url.pathname);

const EXPERIENCE = [
  {
    date: t(locale, "experience.item_4_date"),
    title: t(locale, "experience.item_4_title"),
    company: t(locale, "experience.item_4_company"),
    description: [
      t(locale, "experience.item_4_description_0"),
      t(locale, "experience.item_4_description_1")
    ],
    link: "https://www.andxor.it/",
  },
  {
    date: t(locale, "experience.item_3_date"),
    title: t(locale, "experience.item_3_title"),
    company: t(locale, "experience.item_3_company"),
    description: [
      t(locale, "experience.item_3_description_1"),
      t(locale, "experience.item_3_description_2"),
      t(locale, "experience.item_3_description_3"),
      t(locale, "experience.item_3_description_4"),
    ],
    link: "http://www.sydema.it/laweb4.html",
  },
  {
    date: t(locale, "experience.item_2_date"),
    title: t(locale, "experience.item_2_title"),
    company: t(locale, "experience.item_2_company"),
    description: [
      t(locale, "experience.item_2_description_1"),
      t(locale, "experience.item_2_description_2"),
      t(locale, "experience.item_2_description_3"),
      t(locale, "experience.item_2_description_4"),
      t(locale, "experience.item_2_description_5"),
    ],
    link: "https://empresas.movistar.com.pe/",
  },
  {
    date: t(locale, "experience.item_1_date"),
    title: t(locale, "experience.item_1_title"),
    company: t(locale, "experience.item_1_company"),
    description: [
      t(locale, "experience.item_1_description_1"),
      t(locale, "experience.item_1_description_2"),
      t(locale, "experience.item_1_description_3"),
    ],
    link: "http://www.sunat.gob.pe",
  },
];
---

<div>
  <ExperienceItem {...EXPERIENCE[0]} />
  <details class="group">
    <summary
      class="flex justify-center mt-4 rounded-full animate-bounce list-none [&::-webkit-details-marker]:hidden"
    >
      <span
        class="px-4 py-2 hover:scale-110 cursor-pointer
        dark:text-white text-black rounded 
        dark:border-white/10 border-black/30
        dark:bg-white/5 bg-black/5
        dark:hover:bg-slate-900 hover:bg-black/10
        transition duration-400 ease-in-out
        flex items-center gap-2"
      >
        <svg
          class="w-4 h-4 text-black dark:text-gray-300 rtl:rotate-180 transition-transform duration-300"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 6 10"
        >
          <path
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="m1 9 4-4-4-4"></path>
        </svg>
      </span>
    </summary>
    {EXPERIENCE.slice(1).map((experience) => <ExperienceItem {...experience} />)}
  </details>
</div>

<style>
  /* ponytail: la variante group-open de Tailwind no ganaba; una linea de CSS lo resuelve */
  summary svg {
    rotate: 90deg;
  }
  details[open] summary svg {
    rotate: -90deg;
  }
</style>
